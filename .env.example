# Browser uses a same-origin /api path in production when this value is empty.
VITE_API_BASE_URL=http://localhost:8000

# Backend configuration
AI_TOOLS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
AI_TOOLS_MAX_UPLOAD_BYTES=20971520
AI_TOOLS_MAX_UPLOAD_FILES=20
AI_TOOLS_MAX_REQUEST_BYTES=420478976
AI_TOOLS_ANTIGRAVITY_TIMEOUT_SECONDS=120

# Optional. Leave empty to use the model configured by the Antigravity runtime.
AI_TOOLS_ANTIGRAVITY_MODEL=
